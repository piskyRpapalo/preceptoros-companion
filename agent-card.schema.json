{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preceptoros.agent-card/1",
  "title": "preceptoros.agent-card/1 (PROPOSED)",
  "description": "A card declares and requests; it never grants. Under 1,024 bytes UTF-8 (checked outside the schema). See AGENT_CARD.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fixture", "agent", "contributor", "model", "key", "requests", "conditions", "authority"],
  "$defs": {
    "nodata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "cause"],
      "properties": {
        "state": {"const": "NO_DATA"},
        "cause": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"}
  },
  "properties": {
    "schema": {"const": "preceptoros.agent-card/1"},
    "fixture": {"type": "boolean"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "route"],
      "properties": {
        "id": {
          "allOf": [
            {"$ref": "#/$defs/slug"},
            {"not": {"enum": ["soberano", "sovereign", "orquestador", "hexelion-door", "door", "system"]}}
          ]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 24},
        "kind": {"enum": ["node", "rack-cli", "private", "external"]},
        "route": {"enum": ["thread", "station", "none"]}
      }
    },
    "contributor": {"$ref": "#/$defs/slug"},
    "model": {
      "oneOf": [
        {"$ref": "#/$defs/nodata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 60},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "key": {
      "oneOf": [
        {"$ref": "#/$defs/nodata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "public_hex", "registry"],
          "properties": {
            "alg": {"const": "ed25519"},
            "public_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "registry": {"type": "string", "pattern": "^babel registry/keys/[A-Za-z0-9._-]{1,60}$"}
          }
        }
      ]
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["talk.read", "talk.write", "lab.read_document", "lab.propose", "notebook.receipt", "memory.propose"]}
    },
    "conditions": {
      "oneOf": [
        {"$ref": "#/$defs/nodata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256"],
          "properties": {
            "ref": {"type": "string", "minLength": 1, "maxLength": 120},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "authority": {"const": "none: a card declares and requests; it never grants"}
  },
  "allOf": [
    {
      "if": {"properties": {"fixture": {"const": false}}},
      "then": {"properties": {"key": {"required": ["alg", "public_hex", "registry"]}}}
    },
    {
      "if": {"properties": {"fixture": {"const": true}}},
      "then": {"properties": {"key": {"$ref": "#/$defs/nodata"}}}
    }
  ]
}
